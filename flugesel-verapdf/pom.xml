<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.helger.flugesel</groupId>
    <artifactId>flugesel-parent-pom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>flugesel-verapdf</artifactId>
  <packaging>jar</packaging>
  <name>flugesel-verapdf</name>
  <description>flugesel - PDF/A-3 validation adapter using veraPDF</description>
  <url>https://github.com/phax/flugesel/flugesel-verapdf</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>Apache 2</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <organization>
    <name>Philip Helger</name>
    <url>https://www.helger.com</url>
  </organization>

  <developers>
    <developer>
      <id>philip</id>
      <name>Philip Helger</name>
      <email>philip[at]helger[dot]com</email>
      <url>https://www.helger.com</url>
    </developer>
  </developers>

  <dependencies>
    <dependency>
      <groupId>com.helger.flugesel</groupId>
      <artifactId>flugesel-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.verapdf</groupId>
      <artifactId>validation-model</artifactId>
    </dependency>
    <!--
      veraPDF 1.26.x uses the legacy javax.xml.bind API (jaxb-api:2.4.0-b180830) but ships the
      Jakarta-namespace jaxb-impl 4.x, which does not provide the com.sun.xml.bind.v2.ContextFactory
      class the javax API tries to load. Pin the older 2.3.x JAXB runtime so JAXB can resolve at
      runtime; otherwise validation-profile loading fails and every validation returns an error.
    -->
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>2.3.9</version>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
