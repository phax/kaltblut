<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.helger.kaltblut</groupId>
    <artifactId>kaltblut-parent-pom</artifactId>
    <version>0.9.4-SNAPSHOT</version>
  </parent>
  <artifactId>kaltblut-cli</artifactId>
  <packaging>jar</packaging>
  <name>kaltblut-cli</name>
  <description>kaltblut - ZUGFeRD / Factur-X hybrid invoice toolkit - command line client</description>
  <url>https://github.com/phax/kaltblut/kaltblut-cli</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>Apache 2</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <organization>
    <name>Philip Helger</name>
    <url>https://www.helger.com</url>
  </organization>

  <developers>
    <developer>
      <id>philip</id>
      <name>Philip Helger</name>
      <email>philip[at]helger[dot]com</email>
      <url>https://www.helger.com</url>
    </developer>
  </developers>

  <dependencies>
    <dependency>
      <groupId>com.helger.kaltblut</groupId>
      <artifactId>kaltblut-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.helger.kaltblut</groupId>
      <artifactId>kaltblut-verapdf</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
      <version>${picocli.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
    </dependency>

    <!-- OpenTelemetry: this is the deployment boundary, so the real SDK + exporter live here.
         ph-telemetry-otel transitively brings ph-telemetry + opentelemetry-api. -->
    <dependency>
      <groupId>com.helger.telemetry</groupId>
      <artifactId>ph-telemetry-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-extension-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <!-- okhttp 5.x splits its artifact via Kotlin Multiplatform: the plain "okhttp" jar pulled
         transitively by the OTLP sender is an empty stub, and Maven (unlike Gradle) does not resolve
         the JVM variant. Add okhttp-jvm explicitly so the OTLP sender has okhttp3.RequestBody. -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp-jvm</artifactId>
      <version>${okhttp.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <configuration>
          <createDependencyReducedPom>false</createDependencyReducedPom>
          <shadedArtifactAttached>true</shadedArtifactAttached>
          <finalName>${project.artifactId}-full</finalName>
          <transformers>
            <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
            <transformer implementation="org.apache.maven.plugins.shade.resource.DontIncludeResourceTransformer">
              <resource>.RSA</resource>
              <resource>.SF</resource>
            </transformer>
            <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
              <mainClass>com.helger.kaltblut.cli.KaltblutMain</mainClass>
            </transformer>
          </transformers>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
